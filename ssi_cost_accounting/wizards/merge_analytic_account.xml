<odoo>
<record id="merge_analytic_account_view_form" model="ir.ui.view">
    <field name="name">merge_analytic_account - form</field>
    <field name="model">merge_analytic_account</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field name="analytic_account_ids" widget="many2many_tags" />
                <field
                        name="dst_analytic_account_id"
                        domain="[('id', 'in', analytic_account_ids)]"
                    />
            </group>
            <footer>
                <button
                        name="action_merge"
                        type="object"
                        string="Merge"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record id="merge_analytic_account_action" model="ir.actions.act_window">
    <field name="name">Merge Analytic Accounts</field>
    <field name="res_model">merge_analytic_account</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="merge_analytic_account_view_form" />
    <field name="target">new</field>
    <field name="binding_model_id" ref="analytic.model_account_analytic_account" />
    <field name="binding_view_types">list</field>
    <field
            name="groups_id"
            eval="[(4, ref('account_analytic_account_configurator_group'))]"
        />
</record>
</odoo>
